---
/**
 * Recipe dispatcher. Static recipes draw through STATIC_FIGURES and the
 * pre-rendered heroes through PRERENDERED_HEROES, both on the server only.
 * Islands are listed one by one because Astro must see which components
 * hydrate: a client directive cannot go on a dynamically chosen component.
 * A contract test checks that every registered recipe has exactly one route.
 */
import { PRERENDERED_HEROES, RECIPE_MAP, STATIC_FIGURES, type BaseFixture } from "@bip-atlas/figures";
import { AddressChecksumLab } from "@bip-atlas/figures/AddressChecksumLab.tsx";
import { Bip322VirtualTx } from "@bip-atlas/figures/bip322/Bip322VirtualTx.tsx";
import { GcsFilter } from "@bip-atlas/figures/blockfilters/GcsFilter.tsx";
import { DescriptorAnatomy, DescriptorValues, descriptorSpec } from "@bip-atlas/figures/descriptors/DescriptorAnatomy.tsx";
import { DerivationTree, DerivationTreeValues, derivationTreeSpec } from "@bip-atlas/figures/hd/DerivationTree.tsx";
import { EntropyWordLab } from "@bip-atlas/figures/mnemonic/EntropyWordLab.tsx";
import { Musig2Rounds } from "@bip-atlas/figures/musig2/Musig2Rounds.tsx";
import { SchnorrVerifier } from "@bip-atlas/figures/schnorr/SchnorrVerifier.tsx";
import { SpDerivation } from "@bip-atlas/figures/silentpayments/SpDerivation.tsx";
import { StateHero } from "@bip-atlas/figures/StateHero.tsx";
import { TaprootCommitment } from "@bip-atlas/figures/taproot/TaprootCommitment.tsx";
import { TapscriptTrace } from "@bip-atlas/figures/tapscript/TapscriptTrace.tsx";
import { V2Handshake } from "@bip-atlas/figures/v2/V2Handshake.tsx";
import { VersionbitsMachine } from "@bip-atlas/figures/versionbits/VersionbitsMachine.tsx";
import { WalletPathValues, WalletPathWalk, walletWalkSpec } from "@bip-atlas/figures/wallet/WalletPathWalk.tsx";
import type { Figure } from "@bip-atlas/publication";
import { deriveFixtures } from "../lib/derive";
import Plate from "./Plate.astro";
import HeroStates from "./HeroStates.astro";

interface Props {
  figure: Figure;
  numbers: Map<string, number>;
  fixtures: Map<string, BaseFixture>;
  /** walkBlocks path of this figure, for the caption's citation anchor. */
  path: string;
}
const { figure, numbers, fixtures, path } = Astro.props;
const recipe = RECIPE_MAP.get(figure.recipe);
if (!recipe) throw new Error(`No recipe ${figure.recipe}`);
// Derived and checked at build time; each component declares the fixture type it draws.
const picked: any[] = deriveFixtures(figure.fixtures.map((id) => fixtures.get(id)!));
const figureId = `fig-${figure.figure.replace(".", "-").toLowerCase()}`;
const drawn = STATIC_FIGURES[figure.recipe];
const Static = drawn?.component;
const hero = PRERENDERED_HEROES[figure.recipe];
const heroSpec = hero?.spec(picked);
const Hero = hero?.component;
const is = (id: string) => figure.recipe === id;
---
<Plate figure={figure} numbers={numbers} interactive={recipe.interactive} path={path}>
  {Static && <Static {...drawn.props(picked)} />}
  {heroSpec && (
    <HeroStates figureId={figureId} spec={heroSpec}>
      {heroSpec.states.map((s) => (
        <div data-state data-keys={s.keys.join(" ")} data-valuetext={s.valueText} hidden={s.id !== heroSpec.noJsId}>
          <Hero {...hero.props(picked, `${figureId}-${s.id}`, s.state)} />
        </div>
      ))}
    </HeroStates>
  )}
  {is("address-checksum-lab.v1") && <AddressChecksumLab client:visible fixtures={picked} figureId={figureId} />}
  {is("entropy-word-pipeline.v1") && <EntropyWordLab client:visible fixtures={picked} figureId={figureId} />}
  {is("derivation-tree.v1") && (
    <StateHero client:visible spec={derivationTreeSpec(picked[0], figureId)}>
      <DerivationTree fixture={picked[0]} figureId={figureId} />
      <DerivationTreeValues slot="values" fixture={picked[0]} />
    </StateHero>
  )}
  {is("wallet-path-walk.v1") && (
    <StateHero client:visible spec={walletWalkSpec(picked, figureId)}>
      <WalletPathWalk fixtures={picked} figureId={figureId} />
      <WalletPathValues slot="values" fixtures={picked} />
    </StateHero>
  )}
  {is("descriptor-anatomy.v1") && (
    <StateHero client:visible spec={descriptorSpec(picked, figureId)}>
      <DescriptorAnatomy fixtures={picked} figureId={figureId} />
      <DescriptorValues slot="values" fixtures={picked} />
    </StateHero>
  )}
  {is("schnorr-verification.v1") && <SchnorrVerifier client:visible fixtures={picked} figureId={figureId} />}
  {is("taproot-commitment.v1") && <TaprootCommitment client:visible fixture={picked[0]} figureId={figureId} />}
  {is("tapscript-trace.v1") && <TapscriptTrace client:visible fixtures={picked} figureId={figureId} />}
  {is("versionbits-state-machine.v1") && <VersionbitsMachine client:visible fixtures={picked} figureId={figureId} />}
  {is("musig2-rounds.v1") && <Musig2Rounds client:visible fixtures={picked} figureId={figureId} />}
  {is("silent-payment-derivation.v1") && <SpDerivation client:visible fixtures={picked} figureId={figureId} />}
  {is("gcs-filter.v1") && <GcsFilter client:visible fixtures={picked} figureId={figureId} />}
  {is("v2-handshake.v1") && <V2Handshake client:visible fixtures={picked} figureId={figureId} />}
  {is("bip322-virtual-tx.v1") && <Bip322VirtualTx client:visible fixtures={picked} figureId={figureId} />}
</Plate>
