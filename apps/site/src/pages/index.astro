---
import Base from "../layouts/Base.astro";
import { loadCatalog, loadChapter } from "../lib/content";

const { chapters } = loadCatalog();
const parts = new Map<string, typeof chapters>();
for (const c of chapters) parts.set(c.part, [...(parts.get(c.part) ?? []), c]);
const bipCount = new Set(chapters.flatMap((c) => c.primaryBips)).size;
---
<Base title="BIP Atlas" description="An illustrated field guide to selected Bitcoin Improvement Proposals." current="contents">
  <div class="manual-page">
    <header class="atlas-cover">
      <h1>Bitcoin Improvement Proposals, illustrated</h1>
      <p class="atlas-lede">
        {chapters.length} chapters explain {bipCount} proposals. Each one answers a single question: what changed, and why.
      </p>
      <p class="atlas-small">
        Every statement is checked against the proposals’ own text and test vectors. See the
        <a href="/methodology/">methodology</a>. Inspired by <a href="https://makingsoftware.com">makingsoftware.com</a>.
      </p>
    </header>
    {[...parts].map(([title, list], i) => (
      <section class="atlas-part" aria-labelledby={`part-${i + 1}`}>
        <h2 class="atlas-part__title" id={`part-${i + 1}`}>{title}</h2>
        <ol class="atlas-cards" start={list[0].readingOrder}>
          {list.map((c) => (
            <li>
              <a class="atlas-card" href={`/learn/${c.id}/`}>
                <img
                  class="atlas-card__thumbnail"
                  src={`/thumbnails/${c.id}.png`}
                  alt=""
                  width="352"
                  height="264"
                  loading={c.readingOrder <= 4 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="atlas-card__label">
                  {loadChapter(c.id).publication.specimenLabel}
                  <span class="manual-meta" aria-hidden="true">{String(c.readingOrder).padStart(2, "0")}</span>
                </span>
                <span class="atlas-card__title">{c.questionTitle}</span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Base>
