---
/** /bip/<number>/ is a stable alias that points to the chapter covering that BIP. */
import { listChapterIds, loadChapter } from "../../../lib/content";

export function getStaticPaths() {
  return listChapterIds().flatMap((chapter) =>
    loadChapter(chapter).publication.primaryBips.map((n) => ({ params: { n: String(n) }, props: { chapter } })),
  );
}
const target = `/learn/${Astro.props.chapter}/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to {target}</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
  </head>
  <body><a href={target}>BIP {Astro.params.n} is explained in this chapter.</a></body>
</html>
